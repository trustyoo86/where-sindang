# Copy to .env.local and fill in real values. Do NOT commit .env.local.

# Notion integration (Phase 1)
NOTION_TOKEN=
NOTION_DB_ID=

# Kakao Map JavaScript key (Phase 1, browser-exposed)
NEXT_PUBLIC_KAKAO_MAP_KEY=

# Public base URL for OG tags and absolute links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# On-demand revalidate webhook secret (Phase 1, server-only)
REVALIDATE_SECRET=

# Auth.js (SNS 로그인) — server-only. 실서비스 값은 GitHub Secret / Vercel env로 주입.
# AUTH_SECRET: `npx auth secret` 로 생성
AUTH_SECRET=
AUTH_KAKAO_ID=
AUTH_KAKAO_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Neon Postgres — 찜 저장 (server-only)
DATABASE_URL=
